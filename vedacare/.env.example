# VedaCare Environment Variables
# Copy this to .env and fill in your values

# --- Database ---
DATABASE_URL=sqlite:///./vedacare.db

# --- Backend ---
BACKEND_URL=http://localhost:8000

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000/ai

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud

# --- API Keys (leave blank if using free alternatives) ---
OPENROUTER_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TTS_API_KEY=

# --- Auth ---
JWT_SECRET_KEY=your-secret-key-change-in-production

# --- AI Pipeline Internals ---
AI_AUDIO_OUTPUT_DIR=
AI_OCR_TEMP_DIR=
AI_LLM_MAX_RETRIES=1
AI_LLM_TIMEOUT=120
